{
	"name": "Default template for Java coding",
	"image": "mcr.microsoft.com/devcontainers/base:${templateOption:imageVariant}",

	// Executed commands after container creation
	"postCreateCommand": {
		"Httpd": "jbang app setup && jbang app install httpd@jbangdev"
	},

	// 👇 Features to add to the Dev Container. More info: https://containers.dev/implementors/features.
	 "features": {
		"ghcr.io/devcontainers/features/java:1": {
      "installMaven": true,
			"mavenVersion": "3.10.0",
      "version": "27",
      "jdkDistro": "tem"
    },
		"ghcr.io/devcontainers-extra/features/jbang-sdkman:2": {
			"version": "0.143.0",
			"jdkVersion": "none"
		},
		"ghcr.io/philippart-s/feature-dev-containers-talk/ovhcloud-cli:1.1.0": {}
	 },

	// Mandatory to be allow the JBang VSCode extention to run JBang
	"remoteEnv": {
  	"PATH": "${containerEnv:PATH}:/usr/local/sdkman/candidates/jbang/current/bin"
	},

	// IDE customization
	"customizations": {
		"vscode": {
			"settings": {
				"java.configuration.runtimes": [
					{
						"name": "JavaSE-27",
						"path": "/usr/local/sdkman/candidates/java/current/"
					}
				]
			},
			"extensions": ["jbangdev.jbang-vscode", "vscjava.vscode-java-pack"]
		}
	}
}
